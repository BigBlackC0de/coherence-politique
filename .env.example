# ---- Moteur Claude ----
# auto (défaut) : clé API si ANTHROPIC_API_KEY est renseignée, sinon Claude Code.
#   claude-code : pilote le binaire officiel `claude -p`, couvert par votre abonnement
#                 Claude (Pro/Max) via `claude auth login`. Rien n'est facturé à l'acte,
#                 l'usage est compté dans les quotas de l'abonnement. Usage personnel.
#   api         : SDK Anthropic avec clé API (facturation à l'usage).
COHERENCE_ENGINE=auto
# Clé API Anthropic (moteur api uniquement). Laisser vide pour utiliser Claude Code.
ANTHROPIC_API_KEY=
# Modèle pour le moteur Claude Code (alias : opus, sonnet, haiku, ou identifiant complet)
COHERENCE_CC_MODEL=opus
# Attente maximale (minutes) quand le quota de l'abonnement est atteint, avant d'abandonner
COHERENCE_RATE_WAIT_MAX_MIN=360

# (moteur api) Modèle principal (synthèses, chat, programmes). Défaut : claude-opus-5
COHERENCE_MODEL=claude-opus-5
# (moteur api) Modèle pour les tâches de masse (classification de milliers de scrutins, tweets).
# Défaut : claude-opus-5. Levier de coût : claude-sonnet-5 (≈2,5x moins cher).
COHERENCE_MODEL_BULK=claude-opus-5
# Plafond par job (USD, ou valeur équivalente avec Claude Code). Le job s'arrête proprement au-delà.
COHERENCE_BUDGET_PER_JOB_USD=100

# ---- Base de données ----
COHERENCE_DB_PATH=./data/coherence.db

# ---- Deux instances : l'administration locale et le site public ----
# Machine locale (celle-ci) : interface complète, calculs avec votre Claude. Rien à régler.
#   Optionnel : un jeton pour exiger une connexion sur /admin même en local.
# Site public (serveur) : COHERENCE_PUBLIC=1 → lecture seule, aucune page ni API d'administration,
#   aucune clé Claude nécessaire. Il reçoit la base via `npm run publish` depuis la machine locale.
COHERENCE_PUBLIC=
# Jeton partagé entre la machine locale et le serveur (12 caractères minimum, ex. `openssl rand -hex 24`).
# Sur le serveur, il n'autorise qu'une chose : recevoir la base publiée (PUT /api/admin/db).
COHERENCE_ADMIN_TOKEN=
# Machine locale : adresse du site public vers lequel `npm run publish` pousse la base.
COHERENCE_PUBLISH_URL=

# ---- Partage (images /partager/... et aperçus de liens Open Graph) ----
# Adresse publique du site, affichée en pied des images à partager et utilisée pour les URL
# absolues des aperçus (og:image, og:url). Ex. https://coherence-politique.example.org
# Vide : l'hôte de la requête est utilisé (pratique en local) et les images ne sont mises en cache
# que par le navigateur. À renseigner sur le site public.
# Police des images : Mona Sans, fichiers TTF versionnés dans assets/fonts/ (fonctionne hors ligne) ;
# s'ils manquent, téléchargement depuis Google Fonts, sinon police par défaut de next/og.
COHERENCE_PUBLIC_URL=

# ---- X / Twitter (optionnel) ----
# Créer une app sur https://developer.x.com, type "Web App", callback :
#   http://localhost:3000/api/x/callback
# Depuis février 2026, X facture à l'usage (~0,005 $ par tweet lu). Pas de palier gratuit.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Alternative "app only" (lecture seule, sans connecter votre compte) :
X_BEARER_TOKEN=
# Plafond de tweets lus par rafraîchissement (contrôle du coût X)
X_MAX_READS_PER_REFRESH=2000

# URL publique de l'app (pour le callback OAuth X)
COHERENCE_BASE_URL=http://localhost:3000

# Contact affiché sur les fiches candidats (« Signaler une erreur ») : adresse e-mail ou URL de formulaire.
COHERENCE_CONTACT=
